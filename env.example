# PrintNinja desktop-app environment: the one template for a root `.env`.
# Copy to `.env` in this folder when you need a non-default build:
#   cp env.example .env
# Never commit `.env`. Every variable, explained: docs/ENV.md.
# Commented lines show the built-in default; uncomment only to override.
#
# All of these are BUILD-TIME only (read by vite, baked into the bundle).
# Changing one requires a rebuild (`pnpm build`, `tauri build`).
# There is intentionally no root `.env` for the service itself — that
# lives in `server/.env` (see `server/env.example`).

# Where the top-bar update badge looks for releases:
# GET {VITE_UPDATE_API}/repos/{VITE_UPDATE_REPO}/releases/latest.
# Defaults point at this repo on the public GitHub API.
# VITE_UPDATE_API=https://api.github.com
# VITE_UPDATE_REPO=SAR-dev/PrintNinja

# Address pre-filled on the sign-in screen and Settings -> Share on a
# first run before anything was saved. A saved address always wins.
# Unset or invalid means no pre-fill.
# VITE_DEFAULT_SHARE_URL=https://share.example.com

# Base URL of the dev server for scripts (default: http://localhost:1420).
# Only read by `node scripts/capture-screens.mjs`; the app and the e2e
# stack do not use it.
# BASE_URL=http://localhost:1420
