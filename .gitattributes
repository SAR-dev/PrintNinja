# Shell scripts and Docker files must stay LF or the container fails with
# "exec ./docker-entrypoint.sh: no such file or directory".
*.sh       text eol=lf
Dockerfile text eol=lf
# Dockerignore patterns are parsed byte-for-byte: on a CRLF checkout (Windows
# core.autocrlf) every pattern gains a trailing \r and silently matches
# nothing, so the full repo (multi-GB target/ trees) becomes the build context.
.dockerignore  text eol=lf
*.dockerignore text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
# Biome formats to LF; keep TypeScript LF in the working tree so
# `pnpm lint` passes on Windows checkouts (core.autocrlf would CRLF them).
*.ts       text eol=lf
*.tsx      text eol=lf
