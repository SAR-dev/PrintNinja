# Template for the values the release and ops commands read from the
# environment (local use only). Copy to `.secrets`, fill in values and
# load them into your shell; `.secrets` is gitignored.
#   ANDROID_*      scripts/release-local.mjs (APK/AAB signing)
#   TURSO_*        DATABASE_URL / DATABASE_AUTH_TOKEN for `pnpm --filter server db:apply`
#   SERVICE_URL, CRON_SECRET   only for calling /v2/internal/cleanup by hand
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SERVICE_URL=
CRON_SECRET=
