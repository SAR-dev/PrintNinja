# Template for `act --secret-file .secrets` (local runs only).
# Copy to `.secrets` and fill in values; `.secrets` is gitignored.
# GITHUB_TOKEN is faked by act automatically — only set a real one when
# you must test the release upload path.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SERVICE_URL=
CRON_SECRET=
