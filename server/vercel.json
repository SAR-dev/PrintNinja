{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm db:generate && pnpm build && mkdir -p public && printf 'User-agent: *\\nDisallow: /\\n' > public/robots.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "src/infra/db/generated/**"
    }
  },
  "crons": [{ "path": "/v2/internal/cleanup", "schedule": "17 3 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
